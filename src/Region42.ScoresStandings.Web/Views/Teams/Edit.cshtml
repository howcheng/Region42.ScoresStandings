@model Region42.ScoresStandings.Domain.Entities.Team

@{
	ViewData["Title"] = "Edit Team";
	var divisions = ViewBag.Divisions as SelectList;
}

<h2>Edit Team</h2>
<hr />

<div class="row">
	<div class="col-md-8">
		<form asp-action="Edit" method="post">
			<input type="hidden" asp-for="Id" />
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<div class="mb-3">
				<label asp-for="DivisionId" class="form-label">Division</label>
				<select asp-for="DivisionId" class="form-select" asp-items="divisions">
					<option value="">-- Select Division --</option>
				</select>
				<span asp-validation-for="DivisionId" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Name" class="form-label">Team Name</label>
				<input asp-for="Name" class="form-control" placeholder="e.g., 10UB01 Jets (Smith)" />
				<span asp-validation-for="Name" class="text-danger"></span>
				<small class="form-text text-muted">
					Full team name including team number and coach name in parentheses.
				</small>
			</div>

			<div class="mb-3">
				<label asp-for="ShortName" class="form-label">Short Name</label>
				<input asp-for="ShortName" class="form-control" placeholder="e.g., 01 Jets" maxlength="20" />
				<span asp-validation-for="ShortName" class="text-danger"></span>
				<small class="form-text text-muted">
					Team number + fun name for mobile display (max 20 characters). Example: "01 Jets"
				</small>
			</div>

			<div class="mb-3">
				<label asp-for="ContactName" class="form-label">Contact Name</label>
				<input asp-for="ContactName" class="form-control" placeholder="Coach or team contact" />
				<span asp-validation-for="ContactName" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="ContactEmail" class="form-label">Contact Email</label>
				<input asp-for="ContactEmail" type="email" class="form-control" placeholder="email@example.com" />
				<span asp-validation-for="ContactEmail" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="ContactPhone" class="form-label">Contact Phone</label>
				<input asp-for="ContactPhone" type="tel" class="form-control" placeholder="(555) 123-4567" />
				<span asp-validation-for="ContactPhone" class="text-danger"></span>
			</div>

			<div class="mb-3 form-check">
				<input asp-for="IsActive" class="form-check-input" type="checkbox" />
				<label asp-for="IsActive" class="form-check-label">Active</label>
				<span asp-validation-for="IsActive" class="text-danger"></span>
				<small class="form-text text-muted d-block">
					Inactive teams are hidden from most views but data is preserved.
				</small>
			</div>

			<div class="mb-3 form-check">
				<input asp-for="IsRegion42Team" class="form-check-input" type="checkbox" />
				<label asp-for="IsRegion42Team" class="form-check-label">Region 42 Team</label>
				<span asp-validation-for="IsRegion42Team" class="text-danger"></span>
				<small class="form-text text-muted d-block">
					Uncheck for away region teams (inter-regional games). Away teams are excluded from standings.
				</small>
			</div>

			<div class="mb-3">
				<button type="submit" class="btn btn-primary">
					<i class="bi bi-check-circle"></i> Save Changes
				</button>
				<a asp-action="Index" class="btn btn-secondary">
					<i class="bi bi-x-circle"></i> Cancel
				</a>
			</div>
		</form>

		<div class="mt-4 pt-3 border-top">
			<p class="text-muted small">
				<i class="bi bi-info-circle"></i>
				<strong>Last modified:</strong> @Model.ModifiedAt.ToString("g") by @Model.ModifiedBy
			</p>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card">
			<div class="card-header">
				<i class="bi bi-info-circle"></i> Tips
			</div>
			<div class="card-body">
				<h6>Team Name Format</h6>
				<p class="small">
					Use format: <code>10UB01 Jets (Smith)</code><br />
					- Division code + team number<br />
					- Fun name (optional)<br />
					- Coach name in parentheses
				</p>
				<h6>Short Name</h6>
				<p class="small">
					Displayed on mobile devices. Keep it concise (max 20 chars).
					Example: "01 Jets" or "01 Smith"
				</p>
				<h6>Deactivating Teams</h6>
				<p class="small">
					Uncheck "Active" to hide the team while preserving all historical data.
					Use the Delete button for permanent deactivation with additional safety checks.
				</p>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
