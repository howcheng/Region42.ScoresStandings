@model IEnumerable<Region42.ScoresStandings.Domain.Entities.Team>

@{
	ViewData["Title"] = "Manage Teams";
	var divisions = ViewBag.Divisions as SelectList;
	var selectedDivisionId = ViewBag.Divisions?.SelectedValue;
}

<h2>Manage Teams</h2>
<hr />

@if (!string.IsNullOrEmpty(ViewBag.Message))
{
	<div class="alert alert-info" role="alert">
		@ViewBag.Message
	</div>
}

<div class="row mb-4">
	<div class="col-md-6">
		<label for="divisionSelect" class="form-label">Filter by Division</label>
		<select id="divisionSelect" class="form-select" onchange="filterByDivision()">
			<option value="">-- All Divisions --</option>
			@if (divisions != null)
			{
				foreach (var division in divisions)
				{
					<option value="@division.Value" selected="@(division.Selected)">@division.Text</option>
				}
			}
		</select>
	</div>
	<div class="col-md-6 d-flex align-items-end">
		<a asp-action="Create" class="btn btn-primary">
			<i class="bi bi-plus-circle"></i> Create New Team
		</a>
	</div>
</div>

@if (Model.Any())
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th>Division</th>
					<th>Team Name</th>
					<th>Short Name</th>
					<th>Contact Name</th>
					<th>Contact Email</th>
					<th>Contact Phone</th>
					<th>Status</th>
					<th>Region 42</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var team in Model)
				{
					<tr class="@(team.IsActive ? "" : "table-secondary")">
						<td>@($"{team.Division.AgeGroup} {team.Division.Gender}")</td>
						<td>@team.Name</td>
						<td>@team.ShortName</td>
						<td>@team.ContactName</td>
						<td>@team.ContactEmail</td>
						<td>@team.ContactPhone</td>
						<td>
							@if (team.IsActive)
							{
								<span class="badge bg-success">Active</span>
							}
							else
							{
								<span class="badge bg-secondary">Inactive</span>
							}
						</td>
						<td>
							@if (team.IsRegion42Team)
							{
								<i class="bi bi-check-circle-fill text-success" title="Region 42 Team"></i>
							}
							else
							{
								<i class="bi bi-x-circle text-muted" title="Away Region Team"></i>
							}
						</td>
						<td>
							<a asp-action="Edit" asp-route-id="@team.Id" class="btn btn-sm btn-outline-primary" title="Edit">
								<i class="bi bi-pencil"></i>
							</a>
							@if (team.IsActive)
							{
								<a asp-action="Delete" asp-route-id="@team.Id" class="btn btn-sm btn-outline-danger" title="Deactivate">
									<i class="bi bi-trash"></i>
								</a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div class="mt-3">
		<p class="text-muted">
			<i class="bi bi-info-circle"></i> 
			Showing @Model.Count() team(s). Inactive teams are shown with a gray background.
		</p>
	</div>
}
else
{
	<div class="alert alert-info" role="alert">
		<i class="bi bi-info-circle"></i> 
		No teams found. Click "Create New Team" to add the first team.
	</div>
}

@section Scripts {
	<script>
		function filterByDivision() {
			const divisionId = document.getElementById('divisionSelect').value;
			if (divisionId) {
				window.location.href = '@Url.Action("Index")?divisionId=' + divisionId;
			} else {
				window.location.href = '@Url.Action("Index")';
			}
		}
	</script>
}
