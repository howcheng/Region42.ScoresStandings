@model IEnumerable<Region42.ScoresStandings.Application.DTOs.ScoreEntryDto>

@{
	ViewData["Title"] = "Score Entry";
	var divisions = ViewBag.Divisions as SelectList;
	var rounds = ViewBag.Rounds as SelectList;
	var teams = ViewBag.Teams as List<SelectListItem>;
	var selectedDivisionId = ViewBag.SelectedDivisionId as int?;
	var selectedRound = ViewBag.SelectedRound as int?;
}

<h2>Score Entry</h2>
<hr />

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
	<div class="alert alert-danger" role="alert">
		@ViewBag.ErrorMessage
	</div>
}

<div class="row mb-4">
	<div class="col-md-6">
		<label for="divisionSelect" class="form-label">Division</label>
		<select id="divisionSelect" class="form-select" onchange="reloadPage()">
			<option value="">-- Select Division --</option>
			@if (divisions != null)
			{
				foreach (var division in divisions)
				{
					<option value="@division.Value" selected="@(division.Selected)">@division.Text</option>
				}
			}
		</select>
	</div>
	<div class="col-md-6">
		<label for="roundSelect" class="form-label">Round</label>
		<select id="roundSelect" class="form-select" onchange="reloadPage()" @(selectedDivisionId.HasValue ? "" : "disabled")>
			<option value="">-- Select Round --</option>
			@if (rounds != null)
			{
				foreach (var round in rounds)
				{
					<option value="@round.Value" selected="@(round.Selected)">@round.Text</option>
				}
			}
		</select>
	</div>
</div>

@if (selectedDivisionId.HasValue && selectedRound.HasValue)
{
	if (Model.Any())
	{
		<form asp-action="Entry" method="post">
			<input type="hidden" name="divisionId" value="@selectedDivisionId" />
			<input type="hidden" name="round" value="@selectedRound" />

			<div class="table-responsive">
				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th>Date/Time</th>
							<th>Location</th>
							<th>Home Team</th>
							<th>Home Score</th>
							<th>Away Score</th>
							<th>Away Team</th>
							<th>Last Modified</th>
						</tr>
					</thead>
					<tbody>
						@{
							var index = 0;
						}
						@foreach (var game in Model)
						{
							<tr>
								<td>
									@game.ScheduledDateTime.ToString("ddd, MMM d")
									<br />
									<small class="text-muted">@game.ScheduledDateTime.ToString("h:mm tt")</small>
								</td>
								<td>@game.Location</td>
								<td>
									<input type="hidden" name="scores[@index].GameId" value="@game.GameId" />
									<select name="scores[@index].HomeTeamId" class="form-select form-select-sm" required>
										@if (teams != null)
										{
											foreach (var team in teams)
											{
												<option value="@team.Value" selected="@(team.Value == game.HomeTeamId.ToString())">
													@team.Text
												</option>
											}
										}
									</select>
								</td>
								<td>
									<input type="number" 
										   name="scores[@index].HomeScore" 
										   value="@game.HomeScore" 
										   class="form-control form-control-sm" 
										   min="0" 
										   max="99" 
										   style="width: 70px;" />
								</td>
								<td>
									<input type="number" 
										   name="scores[@index].AwayScore" 
										   value="@game.AwayScore" 
										   class="form-control form-control-sm" 
										   min="0" 
										   max="99" 
										   style="width: 70px;" />
								</td>
								<td>
									<select name="scores[@index].AwayTeamId" class="form-select form-select-sm" required>
										@if (teams != null)
										{
											foreach (var team in teams)
											{
												<option value="@team.Value" selected="@(team.Value == game.AwayTeamId.ToString())">
													@team.Text
												</option>
											}
										}
									</select>
								</td>
								<td>
									@if (game.LastModified.HasValue)
									{
										<small>
											@game.LastModified.Value.ToString("MM/dd/yyyy")
											<br />
											@if (!string.IsNullOrEmpty(game.LastModifiedBy))
											{
												<span class="text-muted">by @game.LastModifiedBy</span>
											}
										</small>
									}
									else
									{
										<span class="text-muted">Not entered</span>
									}
								</td>
							</tr>
							index++;
						}
					</tbody>
				</table>
			</div>

			<div class="mt-3">
				<button type="submit" class="btn btn-primary">
					<i class="bi bi-save"></i> Save All Changes
				</button>
				<a asp-action="Entry" asp-route-divisionId="@selectedDivisionId" asp-route-round="@selectedRound" class="btn btn-secondary">
					<i class="bi bi-arrow-clockwise"></i> Reset
				</a>
			</div>
		</form>

		<div class="alert alert-info mt-4" role="alert">
			<strong>Tips:</strong>
			<ul class="mb-0">
				<li>Use the team dropdowns to make last-minute schedule changes if needed.</li>
				<li><strong>Both scores must be entered for a game to be complete.</strong> Leave both fields empty for games that haven't been played yet.</li>
				<li>Each team can only appear once per round. The system will validate this when you save.</li>
			</ul>
		</div>
	}
	else
	{
		<div class="alert alert-warning" role="alert">
			No games scheduled for this division and round.
		</div>
	}
}
else
{
	<div class="alert alert-info" role="alert">
		Please select a division and round to view games.
	</div>
}

@section Scripts {
	<script>
		function reloadPage() {
			const divisionId = document.getElementById('divisionSelect').value;
			const round = document.getElementById('roundSelect').value;

			// Build URL with selected parameters
			let url = '@Url.Action("Entry", "Scores")';
			const params = [];

			if (divisionId) {
				params.push('divisionId=' + divisionId);
			}
			if (round) {
				params.push('round=' + round);
			}

			if (params.length > 0) {
				url += '?' + params.join('&');
			}

			window.location.href = url;
		}

		// Validate that both scores are entered for each game
		document.addEventListener('DOMContentLoaded', function() {
			const form = document.querySelector('form[action*="Entry"]');
			if (form) {
				form.addEventListener('submit', function(e) {
					const homeScores = document.querySelectorAll('input[name*="HomeScore"]');
					const awayScores = document.querySelectorAll('input[name*="AwayScore"]');
					let hasPartialScore = false;
					let partialGameIndices = [];

					for (let i = 0; i < homeScores.length; i++) {
						const homeValue = homeScores[i].value.trim();
						const awayValue = awayScores[i].value.trim();
						const hasHome = homeValue !== '';
						const hasAway = awayValue !== '';

						// Check if only one score is entered
						if (hasHome !== hasAway) {
							hasPartialScore = true;
							partialGameIndices.push(i + 1);
						}
					}

					if (hasPartialScore) {
						e.preventDefault();
						alert('Error: Both home and away scores must be entered for a game to be complete.\n\n' +
							'Games with incomplete scores: ' + partialGameIndices.join(', ') + '\n\n' +
							'Please either enter both scores or leave both fields empty.');
						return false;
					}
				});
			}
		});
	</script>
}
