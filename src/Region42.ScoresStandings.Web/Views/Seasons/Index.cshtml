@model IEnumerable<Region42.ScoresStandings.Domain.Entities.Season>

@{
	ViewData["Title"] = "Manage Seasons";
}

<h2>Manage Seasons</h2>
<hr />

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success" role="alert">
		@TempData["SuccessMessage"]
	</div>
}

@if (Model.Any())
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th>Season Name</th>
					<th>Year</th>
					<th>Status</th>
					<th>Custom Message (Announcement)</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var season in Model)
				{
					<tr>
						<td>@season.Name</td>
						<td>@season.Year</td>
						<td>
							@if (season.IsActive)
							{
								<span class="badge bg-success">Active</span>
							}
							else
							{
								<span class="badge bg-secondary">Inactive</span>
							}
						</td>
						<td>
							@if (!string.IsNullOrWhiteSpace(season.CustomMessage))
							{
								<span class="text-truncate d-inline-block" style="max-width: 300px;" title="@season.CustomMessage">
									@season.CustomMessage
								</span>
							}
							else
							{
								<span class="text-muted small">None</span>
							}
						</td>
						<td>
							<a asp-action="Edit" asp-route-id="@season.Id" class="btn btn-sm btn-outline-primary" title="Edit">
								<i class="bi bi-pencil"></i> Edit
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
else
{
	<div class="alert alert-info" role="alert">
		<i class="bi bi-info-circle"></i>
		No seasons found in database.
	</div>
}
