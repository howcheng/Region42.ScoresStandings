@model IEnumerable<Region42.ScoresStandings.Domain.Entities.Division>

@{
	ViewData["Title"] = "Manage Divisions";
}

<h2>Manage Divisions</h2>
@if (ViewBag.SeasonName != null)
{
	<p class="text-muted">Season: @ViewBag.SeasonName</p>
}
<hr />

@if (!string.IsNullOrEmpty(ViewBag.Message))
{
	<div class="alert alert-info" role="alert">
		@ViewBag.Message
	</div>
}

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success" role="alert">
		@TempData["SuccessMessage"]
	</div>
}

@if (Model.Any())
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th>Division</th>
					<th class="text-center">Total Rounds</th>
					<th class="text-center">Scrimmage Rounds</th>
					<th class="text-center">Playoff Spots</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var division in Model)
				{
					<tr>
						<td>@($"{division.AgeGroup} {division.Gender}")</td>
						<td class="text-center">@division.TotalRounds</td>
						<td class="text-center">
							@if (division.ScrimmageRounds > 0)
							{
								<span class="badge bg-warning text-dark">@division.ScrimmageRounds</span>
							}
							else
							{
								<span>0</span>
							}
						</td>
						<td class="text-center">@division.PlayoffSpots</td>
						<td>
							<a asp-action="Edit" asp-route-id="@division.Id" class="btn btn-sm btn-outline-primary" title="Edit">
								<i class="bi bi-pencil"></i> Edit
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
else
{
	<div class="alert alert-info" role="alert">
		<i class="bi bi-info-circle"></i>
		No divisions found for the active season.
	</div>
}
