@using Region42.ScoresStandings.Application.Interfaces
@{
	ViewData["Title"] = "Preview CSV Import";
	var teams = ViewBag.Teams as List<CsvTeamPreview> ?? new List<CsvTeamPreview>();
	var games = ViewBag.Games as List<CsvGamePreview> ?? new List<CsvGamePreview>();
	var seasonId = ViewBag.SeasonId;
	var fileName = ViewBag.FileName;

	bool replaceGames = (bool?)TempData["ReplaceGames"] ?? false;
}

<h1>Preview CSV Import</h1>

<div class="alert alert-info">
	<strong>File:</strong> @fileName<br />
	<strong>Season:</strong> @ViewBag.SeasonName (ID: @seasonId)
	@if (replaceGames)
	{
		<br /><span class="badge bg-warning text-dark">Games will be replaced</span>
		TempData.Keep("ReplaceGames");
	}
</div>

@if (teams.Count == 0 && games.Count == 0)
{
	<div class="alert alert-warning">
		No data to preview. Please return to upload and try again.
	</div>
	<a asp-action="Upload" class="btn btn-primary">Back to Upload</a>
}
else
{
	<div class="card mb-4">
		<div class="card-header bg-primary text-white">
			<h5 class="mb-0">Teams to Import (@teams.Count)</h5>
		</div>
		<div class="card-body">
			@if (teams.Count > 0)
			{
				<div class="table-responsive">
					<table class="table table-sm table-striped">
						<thead>
							<tr>
								<th>Team Name</th>
								<th>Age Group</th>
								<th>Gender</th>
								<th>Coach</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var team in teams.OrderBy(t => t.AgeGroup).ThenBy(t => t.Gender).ThenBy(t => t.TeamName))
							{
								<tr>
									<td>@team.TeamName</td>
									<td>@team.AgeGroup</td>
									<td>@team.Gender</td>
									<td>@team.CoachName</td>
									<td>
										@if (team.IsExisting)
										{
											<span class="badge bg-secondary">Existing</span>
										}
										else
										{
											<span class="badge bg-success">New</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<p class="text-muted">No teams to import.</p>
			}
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header bg-primary text-white">
			<h5 class="mb-0">Games to Import (@games.Count)</h5>
		</div>
		<div class="card-body">
			@if (games.Count > 0)
			{
				<div class="table-responsive">
					<table class="table table-sm table-striped">
						<thead>
							<tr>
								<th>Date/Time</th>
								<th>Home Team</th>
								<th>Away Team</th>
								<th>Location</th>
								<th>Round</th>
								<th>Event</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var game in games.OrderBy(g => g.ScheduledDateTime))
							{
								<tr>
									<td>@game.ScheduledDateTime.ToPacificTime("M/d/yyyy h:mm tt")</td>
									<td>@game.HomeTeam</td>
									<td>@game.AwayTeam</td>
									<td>@game.Location</td>
									<td>@game.Round</td>
									<td><small class="text-muted">@game.EventName</small></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<p class="text-muted">No games to import.</p>
			}
		</div>
	</div>

	<form method="post" enctype="multipart/form-data" asp-action="Import" id="importForm">
		<input type="hidden" name="seasonId" value="@seasonId" />

		<!-- Re-upload the file for import -->
		<div class="alert alert-warning">
			<strong>Important:</strong> Please select the same CSV file again to confirm the import.
		</div>

		<div class="mb-3">
			<label for="csvFile" class="form-label">Select CSV File (same file as before)</label>
			<input type="file" class="form-control" id="csvFile" name="csvFile" accept=".csv" required />
		</div>

		<div class="mb-3">
			<button type="submit" class="btn btn-success btn-lg" id="confirmImportBtn">
				<i class="bi bi-check-circle" id="btnIcon"></i>
				<span class="spinner-border spinner-border-sm d-none" id="btnSpinner" role="status" aria-hidden="true"></span>
				<span id="btnText">Confirm Import</span>
			</button>
			<a asp-action="Upload" class="btn btn-secondary" id="cancelBtn">Cancel</a>
		</div>

		@Html.AntiForgeryToken()
	</form>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/js/csv-preview.js" asp-append-version="true"></script>
}
